# Copy to .env and replace both secrets before docker compose up.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Optional separate HTTPS origin for payOS callbacks; defaults to PUBLIC_BASE_URL.
WEBHOOK_BASE_URL=
# For HTTPS behind a reverse proxy: list only the actual proxy IP addresses.
TRUSTED_PROXIES=

