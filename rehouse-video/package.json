{
  "name": "rehouse-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-audio.mjs",
    "dev": "remotion studio src/index.ts",
    "prebuild": "node scripts/generate-audio.mjs",
    "build": "remotion render src/index.ts ReHouseLaunchLandscape out/rehouse-launch.mp4",
    "build:vertical": "remotion render src/index.ts ReHouseTikTokVertical out/rehouse-tiktok.mp4",
    "typecheck": "tsc --noEmit",
    "generate-audio": "node scripts/generate-audio.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "typescript": "6.0.3"
  }
}
